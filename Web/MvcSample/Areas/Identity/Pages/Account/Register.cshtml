@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<link rel="stylesheet" href="~/css/register.css" />

<div class="page-wrapper">

    <!-- Header (fuera de la tarjeta) -->
    <div class="header-container">
        <div class="header-logo-wrapper">
            <img class="header-logo" src="~/img/Background.png" alt="Logo" />
        </div>
        <div class="header-info">
            <div class="header-title">Regístrate</div>
            <div class="header-subtitle">Crea una nueva cuenta</div>
        </div>
    </div>

    <!-- Tarjeta de registro -->
    <div class="card">
        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Nombre / Apellido -->
            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Input.Name">Nombre</label>
                    <input asp-for="Input.Name" class="input-group" placeholder="Nombre" />
                    <span asp-validation-for="Input.Name" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.LastName">Apellido</label>
                    <input asp-for="Input.LastName" class="input-group" placeholder="Apellido" />
                    <span asp-validation-for="Input.LastName" class="text-danger"></span>
                </div>
            </div>

            <!-- Documento / Email -->
            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Input.DocumentNumber">Documento</label>
                    <input asp-for="Input.DocumentNumber" class="input-group" placeholder="Documento" />
                    <span asp-validation-for="Input.DocumentNumber" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.Email">Email</label>
                    <input asp-for="Input.Email" class="input-group" placeholder="Email" autocomplete="username" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.DocumentNumber" class="form-control" placeholder="Documento" />
                <label asp-for="Input.DocumentNumber">Documento</label>
                <span asp-validation-for="Input.DocumentNumber" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <select asp-for="Input.RoleName" class="form-select" aria-required="true">
                    <option value="">-- Seleccione su Perfil --</option>
                    <option value="Estudiante">Estudiante (Reserva Equipos)</option>
                    <option value="Profesor">Profesor (Reserva Salas)</option>
                </select>
                <label asp-for="Input.RoleName">Soy</label>
                <span asp-validation-for="Input.RoleName" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label asp-for="Input.Email">Email</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                <label asp-for="Input.Password">Password</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <!-- Confirmar Contraseña -->
            <div class="form-group">
                <label asp-for="Input.ConfirmPassword">Confirmar Contraseña</label>
                <input asp-for="Input.ConfirmPassword" class="input-group" placeholder="Confirmar contraseña" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-submit">Registrarse</button>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
