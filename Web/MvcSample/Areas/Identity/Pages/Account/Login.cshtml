@page
@model LoginModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    ViewData["Title"] = "Login";
}

<link rel="stylesheet" href="~/css/login.css" />
<div class="login-container">
    <div class="header-login">
        <div class="header-logo-wrapper">
            <img class="header-logo" src="~/img/Background.png" />
        </div>

        <div class="header-info">
            <div class="header-title">SalasSys</div>
            <div class="header-subtitle">Ingresa a tu cuenta para continuar</div>
        </div>
    </div>

    <div class="login-wrapper">
        <div class="login-card">

            <h1>Iniciar Sesión</h1>
            <p class="subtitle">Ingresa tus credenciales para acceder al sistema</p>

            <form method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <!-- EMAIL -->
                <label>Email</label>
                <div class="input-group">
                    <i class="bi bi-envelope-at"></i>
                    <input asp-for="Input.Email" type="email" placeholder="tu@email.com"
                           autocomplete="email" aria-required="true" />
                </div>
                <span asp-validation-for="Input.Email" class="text-danger"></span>

                <!-- PASSWORD -->
                <label>Contraseña</label>
                <div class="input-group">
                    <i class="bi bi-lock"></i>
                    <input asp-for="Input.Password" type="password"
                           placeholder="Tu contraseña"
                           autocomplete="current-password" aria-required="true"
                           id="passwordField" />

                </div>
                <span asp-validation-for="Input.Password" class="text-danger"></span>

                <!-- BOTÓN -->
                <button type="submit" class="btn-login">Iniciar Sesión</button>

            </form>

        </div>
    </div>
</div>

<script src="~/js/Login.js"></script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

