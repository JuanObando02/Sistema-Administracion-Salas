@model IEnumerable<Services.Models.SalaModels.EstadoSalaViewModel>
@using Domain.Enums

@{
    ViewData["Title"] = "Inicio";
}

<link rel="stylesheet" href="~/css/home.css" />

<div class="text-center py-5 bg-light rounded-3 mb-4">
    <h1 class="display-5 fw-bold">Control de Salas</h1>
    <p class="col-md-8 fs-4 mx-auto">Consulte la disponibilidad de espacios y equipos en tiempo real.</p>
</div>
@if (User.IsInRole("Admin") || User.IsInRole("Coordinador"))
{
    // Calculamos los totales aquí mismo para usar variables en el HTML
    var total = Model.Count();
    var disponibles = Model.Count(s => s.Estado == EstadoSala.Disponible);
    var ocupadas = Model.Count(s => s.Estado == EstadoSala.Ocupada);
    var mantenimiento = Model.Count(s => s.Estado == EstadoSala.EnMantenimiento);
    var deshabilitadas = Model.Count(s => s.Estado == EstadoSala.Deshabilitada);

    <div class="row mb-5 g-3">
        @* 1. DISPONIBLES *@
        <div class="col-md">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <span class="text-muted fw-bold small">DISPONIBLES</span>
                        <i class="bi bi-check-circle-fill text-success"></i>
                    </div>
                    <h2 class="display-5 fw-bold text-success mt-2 mb-0">@disponibles</h2>
                </div>
            </div>
        </div>

        @* 2. OCUPADAS *@
        <div class="col-md">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <span class="text-muted fw-bold small">OCUPADAS</span>
                        <i class="bi bi-people-fill text-danger"></i>
                    </div>
                    <h2 class="display-5 fw-bold text-danger mt-2 mb-0">@ocupadas</h2>
                </div>
            </div>
        </div>

        @* 3. DESHABILITADAS *@
        <div class="col-md">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <span class="text-muted fw-bold small">DESHABILITADAS</span>
                        <i class="bi bi-dash-circle-fill text-secondary"></i> @* O bi-stars como en tu imagen *@
                    </div>
                    <h2 class="display-5 fw-bold text-secondary mt-2 mb-0">@deshabilitadas</h2>
                </div>
            </div>
        </div>

        @* 4. MANTENIMIENTO *@
        <div class="col-md">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <span class="text-muted fw-bold small">EN MANTENIMIENTO</span>
                        <i class="bi bi-tools text-primary fs-4"></i>
                    </div>
                    <h2 class="display-5 fw-bold text-primary mt-2 mb-0">@mantenimiento</h2>
                </div>
            </div>
        </div>

        @* 5. TOTAL *@
        <div class="col-md">
            <div class="card h-100 border-0 shadow-sm bg-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <span class="text-muted fw-bold small">TOTAL SALAS</span>
                        <i class="bi bi-menu-button-wide-fill text-total"></i>
                    </div>
                    <h2 class="display-5 fw-bold text-total mt-2 mb-0">@total</h2>
                </div>
            </div>
        </div>
    </div>
}

<div class="row g-3">
    @foreach (var sala in Model)
    {
        <div class="col-12 col-md-6 col-lg-4">
            <div class="sala-card">

                <!-- ENCABEZADO -->
                <div class="sala-header">
                    <h5>@sala.NombreSala</h5>

                    <span class="estado-pill estado-@GetColorEstado(sala.Estado)">
                        @sala.Estado
                    </span>
                </div>

                <!-- TIPO -->
                <div class="tipo-pill">
                    @sala.Tipo
                </div>

                <!-- INFO SEGÚN TIPO -->
                @if (sala.Tipo == TipoSala.Individual)
                {
                    <div class="mt-3 d-flex justify-content-between">
                        <span class="label-grey">Disponibilidad de Equipos:</span>
                        <span class="fw-semibold">@sala.EquiposDisponibles/@sala.Capacidad</span>
                    </div>
                }
                else
                {
                    <div class="mt-3 d-flex justify-content-between">
                        <span class="label-grey">Capacidad Total:</span>
                        <span class="fw-semibold">@sala.Capacidad personas</span>
                    </div>
                }

                <!-- BOTONES -->
                <div class="mt-4">

                    <!-- ADMIN Y COORDINADOR -->
                    @if (User.IsInRole("Admin") || User.IsInRole("Coordinador"))
                    {
                        if (sala.Tipo == TipoSala.Individual)
                        {
                            <a asp-controller="Equipos"
                               asp-action="Index"
                               asp-route-salaId="@sala.Id"
                               class="sala-btn">
                                <i class="bi bi-pencil-square"></i>
                                Gestionar Equipos
                            </a>
                        }
                    }

                    <!-- ESTUDIANTES / PROFESORES -->
                    @if (User.IsInRole("Estudiante") || User.IsInRole("Profesor"))
                    {
                        bool mostrarBoton =
                        (sala.Tipo == TipoSala.Individual && sala.Estado == EstadoSala.Disponible) ||
                        (User.IsInRole("Profesor") &&
                        sala.Tipo == TipoSala.Clase_Completa &&
                        sala.Estado == EstadoSala.Disponible);

                        if (mostrarBoton)
                        {
                            <a asp-controller="Reservas"
                               asp-action="Index"
                               class="sala-btn">
                                <i class="bi bi-calendar-check"></i>
                                Ir a Reservar
                            </a>
                        }
                    }

                </div>
            </div>
        </div>
    }
</div>

@functions {
    string GetColorEstado(EstadoSala estado)
    {
        return estado switch
        {
            EstadoSala.Disponible => "success",
            EstadoSala.Ocupada => "danger",
            EstadoSala.EnMantenimiento => "warning",
            EstadoSala.Deshabilitada => "dark",
            _ => "secondary"
        };
    }
}
