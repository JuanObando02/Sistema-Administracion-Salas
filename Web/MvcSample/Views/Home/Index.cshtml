@model IEnumerable<Services.Models.SalaModels.EstadoSalaViewModel>
@using Domain.Enums @* Importante para los enums *@

@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center py-5 bg-light rounded-3 mb-4">
    <h1 class="display-5 fw-bold">Bienvenido al Sistema de Salas</h1>
    <p class="col-md-8 fs-4 mx-auto">Consulte la disponibilidad de espacios y equipos en tiempo real.</p>
</div>

<div class="row">
    @foreach (var sala in Model)
    {
        <div class="col-md-4 mb-4">
            @* La tarjeta cambia de color de borde según el estado *@
            <div class="card h-100 shadow-sm border-@GetColorEstado(sala.Estado)">
                
                @* Encabezado con color de fondo *@
                <div class="card-header bg-@GetColorEstado(sala.Estado) text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">@sala.NombreSala</h5>
                    @* Icono según el tipo de sala *@
                    @if (sala.Tipo == TipoSala.Individual)
                    {
                        <i class="bi bi-pc-display" title="Sala de Cómputo"></i> @* Requiere Bootstrap Icons *@
                    }
                    else
                    {
                        <i class="bi bi-easel" title="Sala de Clase"></i>
                    }
                </div>

                <div class="card-body">
                    <div class="mb-2">
                        <span class="badge bg-secondary">@sala.Tipo</span>
                        <span class="badge bg-@GetColorEstado(sala.Estado)">@sala.Estado</span>
                    </div>

                    @if (sala.Tipo == TipoSala.Individual)
                    {
                        <p class="card-text mt-3 mb-1">Disponibilidad de Equipos:</p>
                        <div class="progress" style="height: 25px;">
                            @{
                                var porcentaje = sala.Capacidad > 0 ? (double)sala.EquiposDisponibles / sala.Capacidad * 100 : 0;
                                var colorBarra = porcentaje < 20 ? "danger" : (porcentaje < 50 ? "warning" : "success");
                            }
                            <div class="progress-bar bg-@colorBarra" role="progressbar" 
                                 style="width: @porcentaje%;" 
                                 aria-valuenow="@sala.EquiposDisponibles" aria-valuemin="0" aria-valuemax="@sala.Capacidad">
                                @sala.EquiposDisponibles / @sala.Capacidad
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="mt-3">
                            <p class="card-text"><strong>Capacidad Total:</strong> @sala.Capacidad personas</p>
                        </div>
                    }
                </div>

                @* Pie de página con acciones *@
                <div class="card-footer bg-transparent border-0">
                    <div class="d-grid gap-2">
                        @if (User.Identity.IsAuthenticated)
                        {
                            @if (sala.Tipo == TipoSala.Individual)
                            {
                                <a asp-controller="Equipos" asp-action="Index" asp-route-salaId="@sala.Id" class="btn btn-outline-primary btn-sm">
                                    Ver Equipos
                                </a>
                            }
                            
                            @if (User.IsInRole("Profesor") && sala.Tipo == TipoSala.Clase_Completa && sala.Estado == EstadoSala.Disponible)
                            {
                                <a asp-controller="Reservas" asp-action="ReservarSala" class="btn btn-success btn-sm">
                                    Reservar Sala
                                </a>
                            }
                        }
                        else
                        {
                            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-secondary btn-sm">Inicie sesión para reservar</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@* --- FUNCIONES LOCALES PARA ESTILOS --- *@
@functions {
    string GetColorEstado(EstadoSala estado)
    {
        return estado switch
        {
            EstadoSala.Disponible => "success",       // Verde
            EstadoSala.Ocupada => "danger",           // Rojo
            EstadoSala.EnMantenimiento => "warning",  // Amarillo
            EstadoSala.Deshabilitada => "dark",       // Negro/Gris
            _ => "secondary"
        };
    }
}