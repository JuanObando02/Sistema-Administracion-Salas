@model IEnumerable<Services.Models.SalaModels.EstadoSalaViewModel>
@using Domain.Enums @* Importante para los enums *@

@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center py-5 bg-light rounded-3 mb-4">
    <h1 class="display-5 fw-bold">Bienvenido al Sistema de Salas</h1>
    <p class="col-md-8 fs-4 mx-auto">Consulte la disponibilidad de espacios y equipos en tiempo real.</p>
</div>
@if (User.IsInRole("Admin") || User.IsInRole("Coordinador"))
{
    // Calculamos los totales aquí mismo para usar variables en el HTML
    var total = Model.Count();
    var disponibles = Model.Count(s => s.Estado == EstadoSala.Disponible);
    var ocupadas = Model.Count(s => s.Estado == EstadoSala.Ocupada);
    var mantenimiento = Model.Count(s => s.Estado == EstadoSala.EnMantenimiento);
    var deshabilitadas = Model.Count(s => s.Estado == EstadoSala.Deshabilitada);

    <div class="row mb-5 g-3">
        @* 1. DISPONIBLES *@
        <div class="col-md">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <span class="text-muted fw-bold small">DISPONIBLES</span>
                        <i class="bi bi-check-circle text-success fs-4"></i>
                    </div>
                    <h2 class="display-5 fw-bold text-success mt-2 mb-0">@disponibles</h2>
                </div>
            </div>
        </div>

        @* 2. OCUPADAS *@
        <div class="col-md">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <span class="text-muted fw-bold small">OCUPADAS</span>
                        <i class="bi bi-people text-danger fs-4"></i>
                    </div>
                    <h2 class="display-5 fw-bold text-danger mt-2 mb-0">@ocupadas</h2>
                </div>
            </div>
        </div>

        @* 3. DESHABILITADAS *@
        <div class="col-md">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <span class="text-muted fw-bold small">DESHABILITADAS</span>
                        <i class="bi bi-dash-circle text-secondary fs-4"></i> @* O bi-stars como en tu imagen *@
                    </div>
                    <h2 class="display-5 fw-bold text-secondary mt-2 mb-0">@deshabilitadas</h2>
                </div>
            </div>
        </div>

        @* 4. MANTENIMIENTO *@
        <div class="col-md">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <span class="text-muted fw-bold small">EN MANTENIMIENTO</span>
                        <i class="bi bi-tools text-primary fs-4"></i>
                    </div>
                    <h2 class="display-5 fw-bold text-primary mt-2 mb-0">@mantenimiento</h2>
                </div>
            </div>
        </div>

        @* 5. TOTAL *@
        <div class="col-md">
            <div class="card h-100 border-0 shadow-sm bg-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <span class="text-muted fw-bold small">TOTAL SALAS</span>
                        <i class="bi bi-hdd-network text-dark fs-4"></i>
                    </div>
                    <h2 class="display-5 fw-bold text-dark mt-2 mb-0">@total</h2>
                </div>
            </div>
        </div>
    </div>
}

<div class="row">
    @foreach (var sala in Model)
    {
        <div class="col-md-4 mb-4">
            @* La tarjeta cambia de color de borde según el estado *@
            <div class="card h-100 shadow-sm border-@GetColorEstado(sala.Estado)">
                
                @* Encabezado con color de fondo *@
                <div class="card-header bg-@GetColorEstado(sala.Estado) text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">@sala.NombreSala</h5>
                    @* Icono según el tipo de sala *@
                    @if (sala.Tipo == TipoSala.Individual)
                    {
                        <i class="bi bi-pc-display" title="Sala de Cómputo"></i> @* Requiere Bootstrap Icons *@
                    }
                    else
                    {
                        <i class="bi bi-easel" title="Sala de Clase"></i>
                    }
                </div>

                <div class="card-body">
                    <div class="mb-2">
                        <span class="badge bg-secondary">@sala.Tipo</span>
                        <span class="badge bg-@GetColorEstado(sala.Estado)">@sala.Estado</span>
                    </div>

                    @if (sala.Tipo == TipoSala.Individual)
                    {
                        <p class="card-text mt-3 mb-1">Disponibilidad de Equipos:</p>
                        <div class="progress" style="height: 25px;">
                            @{
                                var porcentaje = sala.Capacidad > 0 ? (double)sala.EquiposDisponibles / sala.Capacidad * 100 : 0;
                                var colorBarra = porcentaje < 20 ? "danger" : (porcentaje < 50 ? "warning" : "success");
                            }
                            <div class="progress-bar bg-@colorBarra" role="progressbar" 
                                 style="width: @porcentaje%;" 
                                 aria-valuenow="@sala.EquiposDisponibles" aria-valuemin="0" aria-valuemax="@sala.Capacidad">
                                @sala.EquiposDisponibles / @sala.Capacidad
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="mt-3">
                            <p class="card-text"><strong>Capacidad Total:</strong> @sala.Capacidad personas</p>
                        </div>
                    }
                </div>

                @* Pie de página con acciones *@
                <div class="card-footer bg-transparent border-0 text-center">
                    <div class="d-grid gap-2">
                        @* --- CASO 1: ADMINISTRADORES (Gestión) --- *@
                        @if (User.IsInRole("Admin") || User.IsInRole("Coordinador"))
                        {
                            if (sala.Tipo == TipoSala.Individual)
                            {
                                <a asp-controller="Equipos"
                                    asp-action="Index"
                                    asp-route-salaId="@sala.Id"
                                    class="btn btn-outline-primary btn-sm">
                                    Gestionar Equipos
                                </a>
                            }
                        }
                        @* --- CASO 2: ESTUDIANTES Y PROFESORES (Reserva) --- *@
                        @if (User.IsInRole("Estudiante") || User.IsInRole("Profesor"))
                        {
                            bool mostrarBoton = (sala.Tipo == TipoSala.Individual && sala.Estado == EstadoSala.Disponible) ||
                            (User.IsInRole("Profesor") && sala.Tipo == TipoSala.Clase_Completa && sala.Estado == EstadoSala.Disponible);

                            if (mostrarBoton)
                            {
                                @* Los llevamos a "Mis Reservas" como pediste *@
                                <a asp-controller="Reservas"
                                    asp-action="Index"
                                    class="btn btn-success btn-sm">
                                    Ir a Reservar
                                </a>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@* --- FUNCIONES LOCALES PARA ESTILOS --- *@
@functions {
    string GetColorEstado(EstadoSala estado)
    {
        return estado switch
        {
            EstadoSala.Disponible => "success",       // Verde
            EstadoSala.Ocupada => "danger",           // Rojo
            EstadoSala.EnMantenimiento => "warning",  // Amarillo
            EstadoSala.Deshabilitada => "dark",       // Negro/Gris
            _ => "secondary"
        };
    }
}