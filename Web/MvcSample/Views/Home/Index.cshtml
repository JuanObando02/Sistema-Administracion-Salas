@model IEnumerable<Services.Models.SalaModels.EstadoSalaViewModel>
@using Domain.Enums

@{
    ViewData["Title"] = "Inicio";
}

<style>
    .sala-card {
        border-radius: 14px;
        border: 1px solid #e5e5e5;
        padding: 20px;
        background: #ffffff;
        box-shadow: 0px 3px 8px rgba(0,0,0,0.06);
        transition: 0.2s;
        height: 100%;
    }

        .sala-card:hover {
            transform: translateY(-3px);
        }

    .sala-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }

    .estado-pill {
        font-size: 0.85rem;
        font-weight: 600;
        padding: 5px 14px;
        border-radius: 20px;
    }

    .estado-success {
        background: #d6f5e3;
        color: #18794e;
        border: 1px solid #b6efcf;
    }

    .estado-danger {
        background: #ffe0e0;
        color: #b91c1c;
        border: 1px solid #ffb3b3;
    }

    .estado-warning {
        background: #fff3cd;
        color: #8a6d00;
        border: 1px solid #ffe39c;
    }

    .estado-dark {
        background: #e3e3e3;
        color: #333;
        border: 1px solid #ccc;
    }

    .tipo-pill {
        background: #0a0a1a;
        color: #fff;
        font-size: 0.75rem;
        padding: 5px 12px;
        border-radius: 8px;
        display: inline-block;
        font-weight: 600;
        margin-bottom: 10px;
    }

    .label-grey {
        color: #6c757d;
        font-weight: 500;
        font-size: 0.95rem;
    }

    .sala-btn {
        width: 100%;
        border-radius: 10px;
        border: 1px solid #dcdcdc;
        background: #fff;
        padding: 10px;
        font-weight: 600;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        color: #333;
        transition: 0.2s;
    }

        .sala-btn:hover {
            background: #f5f5f5;
        }

        .sala-btn i {
            font-size: 16px;
        }
</style>

<div class="text-center py-5 bg-light rounded-3 mb-4">
    <h1 class="display-5 fw-bold">Control de Salas</h1>
    <p class="col-md-8 fs-4 mx-auto">Consulte la disponibilidad de espacios y equipos en tiempo real.</p>
</div>

<div class="row g-3">
    @foreach (var sala in Model)
    {
        <div class="col-12 col-md-6 col-lg-4">
            <div class="sala-card">

                <!-- ENCABEZADO -->
                <div class="sala-header">
                    <h5>@sala.NombreSala</h5>

                    <span class="estado-pill estado-@GetColorEstado(sala.Estado)">
                        @sala.Estado
                    </span>
                </div>

                <!-- TIPO -->
                <div class="tipo-pill">
                    @sala.Tipo
                </div>

                <!-- INFO SEGÚN TIPO -->
                @if (sala.Tipo == TipoSala.Individual)
                {
                    <div class="mt-3 d-flex justify-content-between">
                        <span class="label-grey">Disponibilidad de Equipos:</span>
                        <span class="fw-semibold">@sala.EquiposDisponibles/@sala.Capacidad</span>
                    </div>
                }
                else
                {
                    <div class="mt-3 d-flex justify-content-between">
                        <span class="label-grey">Capacidad Total:</span>
                        <span class="fw-semibold">@sala.Capacidad personas</span>
                    </div>
                }

                <!-- BOTONES -->
                <div class="mt-4">

                    <!-- ADMIN Y COORDINADOR -->
                    @if (User.IsInRole("Admin") || User.IsInRole("Coordinador"))
                    {
                        if (sala.Tipo == TipoSala.Individual)
                        {
                            <a asp-controller="Equipos"
                               asp-action="Index"
                               asp-route-salaId="@sala.Id"
                               class="sala-btn">
                                <i class="bi bi-pencil-square"></i>
                                Gestionar Equipos
                            </a>
                        }
                    }

                    <!-- ESTUDIANTES / PROFESORES -->
                    @if (User.IsInRole("Estudiante") || User.IsInRole("Profesor"))
                    {
                        bool mostrarBoton =
                        (sala.Tipo == TipoSala.Individual && sala.Estado == EstadoSala.Disponible) ||
                        (User.IsInRole("Profesor") &&
                        sala.Tipo == TipoSala.Clase_Completa &&
                        sala.Estado == EstadoSala.Disponible);

                        if (mostrarBoton)
                        {
                            <a asp-controller="Reservas"
                               asp-action="Index"
                               class="sala-btn">
                                <i class="bi bi-calendar-check"></i>
                                Ir a Reservar
                            </a>
                        }
                    }

                </div>
            </div>
        </div>
    }
</div>

@functions {
    string GetColorEstado(EstadoSala estado)
    {
        return estado switch
        {
            EstadoSala.Disponible => "success",
            EstadoSala.Ocupada => "danger",
            EstadoSala.EnMantenimiento => "warning",
            EstadoSala.Deshabilitada => "dark",
            _ => "secondary"
        };
    }
}
