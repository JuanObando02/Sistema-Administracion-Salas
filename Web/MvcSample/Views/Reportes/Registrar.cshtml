@model Services.Models.ReporteModels.CrearReporteModel
@using Domain.Enums

@{
    ViewData["Title"] = "Editar Equipo";
}

<link rel="stylesheet" href="~/css/reporteDaño.css" />
<div class="modal-wrapper">
    <div class="radix-ru">
        <!-- Título -->
        <div class="flex-flex-col-gap-2-text-center-sm-text-left">
            <div class="nuevo-usuario">@ViewData["Title"]</div>
            <div class="registra-un-nuevo-usuario-en-el-sistema">
                Complete los datos del reporte
            </div>
        </div>

        <!-- Formulario -->
        <form asp-action="Registrar" method="post" class="form-space-y-4">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Tipo de Reporte -->
            <div>
                <div class="nombre">Tipo</div>
                <div class="input-nombre">
                    <select asp-for="Tipo" asp-items="Html.GetEnumSelectList<TipoReporte>()" class="form-control form-control-sm border-0 bg-transparent" id="ddlTipo">
                        <option value="">-- Seleccione --</option>
                    </select>
                </div>
                <span asp-validation-for="Tipo" class="text-danger"></span>
            </div>

            <!-- Sala -->
            <div id="divSala">
                <div class="apellido">Sala</div>
                <div class="input-apellido">
                    <select asp-for="SalaId" asp-items="Model.SalasDisponibles" class="form-control form-control-sm border-0 bg-transparent" id="ddlSala">
                        <option value="">-- Seleccione Sala --</option>
                    </select>
                </div>
                <span asp-validation-for="SalaId" class="text-danger"></span>
            </div>

            <!-- Equipo -->
            <div id="divEquipo" style="display:none;">
                <div class="tel-fono">Equipo Afectado</div>
                <div class="input-telefono">
                    <select asp-for="EquipoId" asp-items="Model.EquiposDisponibles" class="form-control form-control-sm border-0 bg-transparent" id="ddlEquipo">
                        <option value="">-- Seleccione Equipo --</option>
                    </select>
                </div>
                <span asp-validation-for="EquipoId" class="text-danger"></span>
            </div>

            <!-- Descripción -->
            <div>
                <div class="identificaci-n">Descripción</div>
                <div class="input-dni input-textarea">
                    <textarea asp-for="Descripcion" class="form-control form-control-sm border-0 bg-transparent"></textarea>
                </div>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <!-- Botones -->
            <div class="form-buttons">
                <div class="button-inline-flex-items-center-justify-center">
                    <div class="registra-usuario">Enviar Reporte</div>
                    <input type="submit" class="position-absolute opacity-0" style="width:100%; height:100%; top:0; left:0;" />
                </div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary btn-cancel">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
@{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {

            function toggleCampos() {
                var tipoTexto = $('#ddlTipo option:selected').text();
                var divSala = $('#divSala');
                var divEquipo = $('#divEquipo');

                if (tipoTexto === 'Equipo') {
                    divSala.show();
                    divEquipo.show();
                } else if (tipoTexto === 'Sala') {
                    divSala.show();
                    divEquipo.hide();
                } else {
                    divSala.hide();
                    divEquipo.hide();
                }
            }

            $('#ddlTipo').change(function () {
                toggleCampos();
            });

            toggleCampos();

            $('#ddlSala').change(function () {
                var salaId = $(this).val();
                var ddlEquipo = $('#ddlEquipo');

                ddlEquipo.empty();
                ddlEquipo.append('<option value="">Cargando equipos...</option>');

                if (salaId) {
                    $.getJSON('/Reportes/GetEquiposPorSala', { salaId: salaId }, function (data) {
                        ddlEquipo.empty();
                        ddlEquipo.append('<option value="">-- Seleccione Equipo --</option>');
                        $.each(data, function (index, item) {
                            ddlEquipo.append('<option value="' + item.value + '">' + item.text + '</option>');
                        });
                    });
                } else {
                    ddlEquipo.empty();
                    ddlEquipo.append('<option value="">-- Seleccione primero una Sala --</option>');
                }
            });
        });
    </script>
}
