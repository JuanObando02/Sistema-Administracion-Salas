@using Services.Models.Shared
@model PaginatedList<Services.Models.ReporteModels.ReporteAdminIndexModel>
@using Domain.Enums

@{
    ViewData["Title"] = "Gestión de Reportes";

    // Variables de paginación y filtros
    var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
    var nextDisabled = !Model.HasNextPage ? "disabled" : "";
    var busqueda = ViewData["BusquedaActual"];
    var estado = ViewData["EstadoActual"];
    var fecha = ViewData["FechaActual"];
}

<h1>@ViewData["Title"]</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card mb-4 bg-light">
    <div class="card-body">
        <form asp-action="Gestionar" method="get" class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Buscar</label>
                <input type="text" name="busqueda" class="form-control" placeholder="Serial, Sala o Descripción..." value="@busqueda">
            </div>
            <div class="col-md-3">
                <label class="form-label">Estado</label>
                <select name="estado" class="form-select" asp-items="Html.GetEnumSelectList<EstadoReporte>()">
                    <option value="">-- Todos --</option>
                </select>
                @if (estado != null)
                {
                    <script>document.getElementsByName('estado')[0].value = '@estado';</script>
                }
            </div>
            <div class="col-md-3">
                <label class="form-label">Fecha</label>
                <input type="date" name="fecha" class="form-control" value="@fecha">
            </div>
            <div class="col-md-2 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary w-100">Filtrar</button>
                <a asp-action="Gestionar" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i></a>
            </div>
        </form>
    </div>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Fecha</th>
            <th>Tipo</th>
            <th>Ubicación</th>
            <th>Reportado Por</th>
            <th>Descripción</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FechaCreacion.ToString("dd/MM HH:mm")</td>
                <td>@item.Tipo</td>
                <td class="fw-bold">@item.ObjetoAfectado</td>
                <td>@item.NombreUsuario</td>
                <td>
                    <span class="d-inline-block text-truncate" style="max-width: 200px;" title="@item.Descripcion">
                        @item.Descripcion
                    </span>
                </td>
                <td>
                    @if (item.Estado == EstadoReporte.Pendiente)
                    {
                        <span class="badge bg-warning text-dark">Pendiente</span>
                    }
                    else if (item.Estado == EstadoReporte.EnProceso)
                    {

                        <span class="badge bg-info text-dark">En Proceso</span>
                    }
                    else if (item.Estado == EstadoReporte.Cerrado)
                    {

                        <span class="badge bg-success">Cerrado</span>
                    }
                </td>
                <td>
                    <div class="d-flex gap-2">
                        @* BOTÓN ATENDER (Solo si está pendiente) *@
                        @if (item.Estado == EstadoReporte.Pendiente)
                        {
                            <form asp-action="Atender" asp-route-id="@item.Id" method="post">
                                <button type="submit" class="btn btn-sm btn-primary" title="Marcar En Proceso">
                                    <i class="bi bi-play-fill"></i> Atender
                                </button>
                            </form>
                        }

                        @* BOTÓN CERRAR (Solo si está En Proceso) *@
                        @if (item.Estado == EstadoReporte.EnProceso)
                        {
                            <button type="button"
                                    class="btn btn-sm btn-success btn-cerrar"
                                    data-id="@item.Id"
                                    data-bs-toggle="modal"
                                    data-bs-target="#modalCerrar"
                                    title="Cerrar Reporte">
                                <i class="bi bi-check-lg"></i> Cerrar
                            </button>
                        }
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<nav>
    <ul class="pagination justify-content-center">
        <li class="page-item @prevDisabled">
            <a asp-action="Gestionar" asp-route-pagina="@(Model.PageIndex - 1)" asp-route-busqueda="@busqueda" asp-route-estado="@estado" class="page-link">Anterior</a>
        </li>
        <li class="page-item disabled"><span class="page-link">Página @Model.PageIndex de @Model.TotalPages</span></li>
        <li class="page-item @nextDisabled">
            <a asp-action="Gestionar" asp-route-pagina="@(Model.PageIndex + 1)" asp-route-busqueda="@busqueda" asp-route-estado="@estado" class="page-link">Siguiente</a>
        </li>
    </ul>
</nav>

<div class="modal fade" id="modalCerrar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Cerrar" method="post">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">Cerrar Reporte</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="reporteIdCerrar" />
                    <div class="mb-3">
                        <label class="form-label">Observaciones / Solución (Opcional)</label>
                        <textarea name="observaciones" class="form-control" rows="3" placeholder="Describa cómo se solucionó..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success">Confirmar Cierre</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Script para pasar el ID al Modal
        $(document).ready(function () {
            $('.btn-cerrar').click(function () {
                var id = $(this).data('id');
                $('#reporteIdCerrar').val(id);
            });
        });
    </script>
}