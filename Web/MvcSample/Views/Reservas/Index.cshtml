@model IEnumerable<Services.Models.ReservaModels.ReservaIndexModel>
@using Domain.Enums

@{
    ViewData["Title"] = "Mis Reservas";
    var ahora = DateTime.Now;
}

<link rel="stylesheet" href="~/css/tableSala.css" />

<h1 class="mb-4">@ViewData["Title"]</h1>

<p>
    @if (User.IsInRole("Estudiante"))
    {
        <a asp-action="ReservarEquipo" class="modern-btn btn-primary">Reservar un Equipo</a>
    }

    @if (User.IsInRole("Profesor"))
    {
        <a asp-action="ReservarEquipo" class="modern-btn btn-primary">Reservar un Equipo</a>
        <a asp-action="ReservarSala" class="modern-btn btn-success">Reservar Sala Completa</a>
    }
</p>

<h3>Mi Historial de Reservas</h3>

<div class="table-wrapper">
    <table class="table-modern">
        <thead>
            <tr>
                <th>Tipo</th>
                <th>Objeto Reservado</th>
                <th>Desde</th>
                <th>Hasta</th>
                <th>Estado</th>
                <th>Opciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                bool enCurso = (item.Estado == EstadoReserva.Aprobada || item.Estado == EstadoReserva.EnUso)
                && ahora >= item.FechaInicio
                && ahora <= item.FechaFin;

                <tr>
                    <td>@item.Tipo</td>
                    <td>@item.ObjetoReservado</td>
                    <td>@item.FechaInicio.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@item.FechaFin.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        @if (enCurso)
                        {
                            <span class="badge-modern badge-success">En Curso (Activa)</span>
                        }
                        else if (item.Estado == EstadoReserva.Pendiente)
                        {
                            <span class="badge-modern badge-warning">Pendiente</span>
                        }
                        else if (item.Estado == EstadoReserva.Finalizada)
                        {
                            <span class="badge-modern badge-disabled">Finalizada</span>
                        }
                        else if (item.Estado == EstadoReserva.Rechazada)
                        {
                            <span class="badge-modern badge-danger">Rechazada</span>
                        }
                        else
                        {
                            <span class="badge-modern badge-primary">@item.Estado</span>
                        }
                    </td>
                    <td>
                        @* Cancelar (solo si no ha pasado y no está en curso) *@
                        @if (item.Estado == EstadoReserva.Aprobada && ahora < item.FechaInicio)
                        {
                            <a asp-action="Cancelar" asp-route-id="@item.Id" class="modern-btn btn-delete">Cancelar</a>
                        }

                        @* Acciones en curso *@
                        @if (enCurso)
                        {
                            <div class="d-flex gap-2 flex-wrap">
                                <form asp-action="Finalizar" asp-route-id="@item.Id" method="post"
                                      onsubmit="return confirm('¿Ya terminaste? Al finalizar, el equipo quedará libre para otros usuarios.');">
                                    <button type="submit" class="modern-btn btn-success">
                                        <i class="bi bi-check-circle-fill"></i> Finalizar
                                    </button>
                                </form>

                                <a asp-controller="Asesorias"
                                   asp-action="Solicitar"
                                   asp-route-salaId="@item.SalaId"
                                   class="modern-btn btn-primary">
                                    <i class="bi bi-tools"></i> Ayuda
                                </a>

                                <a asp-controller="Reportes"
                                   asp-action="Registrar"
                                   asp-route-salaId="@item.SalaId"
                                   asp-route-equipoId="@item.EquipoId"
                                   class="modern-btn btn-warning">
                                    <i class="bi bi-exclamation-triangle"></i> Reportar
                                </a>
                            </div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
