@model IEnumerable<Services.Models.ReservaModels.ReservaIndexModel>
@using Domain.Enums

@{
    ViewData["Title"] = "Mis Reservas";
}

<h1>@ViewData["Title"]</h1>

<p>
    @* El estudiante solo ve el botón de "Reservar Equipo" *@
    @if (User.IsInRole("Estudiante"))
    {
        <a asp-action="ReservarEquipo" class="btn btn-primary">Reservar un Equipo</a>
    }

    @* El profesor ve ambos botones *@
    @if (User.IsInRole("Profesor"))
    {
        <a asp-action="ReservarEquipo" class="btn btn-primary">Reservar un Equipo</a>
        <a asp-action="ReservarSala" class="btn btn-success">Reservar Sala Completa</a>
    }
</p>

<h3>Mi Historial de Reservas</h3>
<table class="table">
    <thead>
        <tr>
            <th>Tipo</th>
            <th>Objeto Reservado</th>
            <th>Desde</th>
            <th>Hasta</th>
            <th>Estado</th>
            <th>Opciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Tipo</td>
                <td>@item.ObjetoReservado</td>
                <td>@item.FechaInicio</td>
                <td>@item.FechaFin</td>
                <td>@item.Estado</td>
                <td>
                    @* --- LOGICA DE CANCELACIÓN --- *@
                    @* Solo mostramos el botón si la reserva NO está Finalizada, En Uso o Rechazada *@
                    @if (item.Estado != EstadoReserva.Finalizada &&
                                    item.Estado != EstadoReserva.EnUso &&
                                    item.Estado != EstadoReserva.Rechazada)
                    {
                        <a asp-action="Cancelar" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Cancelar</a>
                    }
                    @* --- BOTÓN REPORTAR --- *@
                    @if (item.Tipo == Domain.Enums.TipoReserva.Equipo) //
                    {
                        @* Pasamos el ID del Equipo para que se pre-llene *@
                        @* Nota: Asumimos que tu ReservaIndexModel tiene acceso al EquipoId o SalaId. 
                        Si no, debes agregarlo al modelo ReservaIndexModel *@

                        <a asp-controller="Reportes"
                           asp-action="Registrar"
                           asp-route-salaId="@item.SalaId"
                           asp-route-equipoId="@item.EquipoId"
                           class="btn btn-sm btn-warning">
                            Reportar Daño
                        </a>
                    }
                    else
                    {
                        @* Pasamos solo el ID de la Sala *@
                        <a asp-controller="Reportes"
                           asp-action="Registrar"
                           asp-route-salaId="@item.SalaId"
                           class="btn btn-sm btn-warning">
                            Reportar Daño
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>