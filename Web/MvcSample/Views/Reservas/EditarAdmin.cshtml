@model Services.Models.ReservaModels.EditarReservaAdminModel
@using Domain.Enums

@{
    ViewData["Title"] = "Modificar Reserva";
}

<link rel="stylesheet" href="~/css/equiposEdit.css" />

<div class="modal-wrapper">
    <div class="radix-ru">
        <!-- Título -->
        <div class="flex-flex-col-gap-2-text-center-sm-text-left">
            <div class="nuevo-usuario">Modificar Reserva</div>
            <div class="registra-un-nuevo-usuario-en-el-sistema">
                Modifique la información de la reserva
            </div>
        </div>

        <!-- Formulario -->
        <form asp-action="EditarAdmin" method="post" class="form-space-y-4">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Tipo" />

            <!-- Fecha Inicio -->
            <div>
                <label asp-for="FechaInicio" class="fecha-de-nacimiento"></label>
                <div class="input-fecha-nacimiento">
                    <input asp-for="FechaInicio" class="form-control form-control-sm border-0 bg-transparent" type="datetime-local" step="1800" />
                </div>
                <span asp-validation-for="FechaInicio" class="text-danger"></span>
            </div>

            <!-- Fecha Fin -->
            <div>
                <label asp-for="FechaFin" class="fecha-de-nacimiento"></label>
                <div class="input-fecha-nacimiento">
                    <input asp-for="FechaFin" class="form-control form-control-sm border-0 bg-transparent" type="datetime-local" step="1800" />
                </div>
                <span asp-validation-for="FechaFin" class="text-danger"></span>
            </div>

            <!-- Sala -->
            <div>
                <label asp-for="SalaId" class="tel-fono">Sala</label>
                <div class="input-telefono">
                    <select asp-for="SalaId"
                            asp-items="Model.SalasDisponibles"
                            class="form-control form-control-sm border-0 bg-transparent"
                            id="ddlSala">
                    </select>
                </div>
                <span asp-validation-for="SalaId" class="text-danger"></span>
            </div>

            <!-- Equipo -->
            @if (Model.Tipo == TipoReserva.Equipo)
            {
                <div>
                    <label asp-for="EquipoId" class="tel-fono">Equipo</label>
                    <div class="input-telefono">
                        <select asp-for="EquipoId"
                                asp-items="Model.EquiposDisponibles"
                                class="form-control form-control-sm border-0 bg-transparent"
                                id="ddlEquipo">
                            <option value="">-- Seleccione Equipo --</option>
                        </select>
                    </div>
                    <span class="form-text">Si cambia la sala, guarde para refrescar equipos o use JS.</span>
                </div>
            }

            <!-- Botones -->
            <div class="form-buttons">
                <div class="btn-submit-modal">
                    Guardar Cambios
                    <input type="submit" />
                </div>
                <a asp-action="Gestionar" class="btn-cancel-modal">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
@{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        $(document).ready(function () {
            function cargarEquipos() {
                var salaId = $('#ddlSala').val();
                var fechaInicio = $('#FechaInicio').val();
                var fechaFin = $('#FechaFin').val();
                var reservaId = $('#Id').val();
                var ddlEquipo = $('#ddlEquipo');

                if (!salaId) {
                    ddlEquipo.empty().append('<option value="">-- Seleccione Sala Primero --</option>');
                    return;
                }

                if (!fechaInicio || !fechaFin) {
                    ddlEquipo.empty().append('<option value="">-- Seleccione Fechas Primero --</option>');
                    return;
                }

                ddlEquipo.empty().append('<option value="">Buscando disponibles...</option>');

                $.ajax({
                    url: '/Reservas/GetEquiposPorSalaJson',
                    type: 'GET',
                    data: {
                        salaId: salaId,
                        inicio: fechaInicio,
                        fin: fechaFin,
                        reservaId: reservaId
                    },
                    success: function (data) {
                        ddlEquipo.empty();
                        if (data.length === 0) {
                            ddlEquipo.append('<option value="">-- No hay equipos disponibles en este horario --</option>');
                        } else {
                            ddlEquipo.append('<option value="">-- Seleccione Equipo --</option>');
                            $.each(data, function (index, item) {
                                ddlEquipo.append('<option value="' + item.value + '">' + item.text + '</option>');
                            });
                        }
                    },
                    error: function () {
                        ddlEquipo.empty().append('<option value="">Error al cargar</option>');
                    }
                });
            }

            $('#ddlSala, #FechaInicio, #FechaFin').change(cargarEquipos);
        });
    </script>
}
