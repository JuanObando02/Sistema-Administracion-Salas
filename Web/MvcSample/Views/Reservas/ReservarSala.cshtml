@model Services.Models.ReservaModels.ReservarSalaModel

@{
    ViewData["Title"] = "Reservar Sala Completa";
}

<link rel="stylesheet" href="~/css/equiposEdit.css" />

<div class="modal-wrapper">
    <div class="radix-ru">

        <!-- Título -->
        <div class="flex-flex-col-gap-2-text-center-sm-text-left">
            <div class="nuevo-usuario">@ViewData["Title"]</div>
            <div class="registra-un-nuevo-usuario-en-el-sistema">
                <strong>Horario de Atención:</strong> 7:00 AM a 9:30 PM.<br />
                <strong>Nota para Profesores:</strong> Esta reserva quedará en estado <strong>Pendiente</strong> hasta que un coordinador la apruebe.
            </div>
        </div>

        <!-- Formulario -->
        <form asp-action="ReservarSala" method="post" class="form-space-y-4">

            <div>
                <div class="nombre">Sala</div>
                <div class="input-nombre">
                    <select asp-for="SalaId" asp-items="Model.SalasDisponibles">
                        <option value="">-- Seleccione una Sala de Clase --</option>
                    </select>
                </div>
                <span asp-validation-for="SalaId" class="text-danger"></span>
            </div>

            <div>
                <div class="nombre">Fecha y Hora de Inicio</div>
                <div class="input-nombre">
                    <input name="FechaInicio"
                           id="FechaInicio"
                           type="datetime-local"
                           value="@Model.FechaInicio.ToString("yyyy-MM-ddTHH:mm")"
                           step="1800" />
                </div>
                <span asp-validation-for="FechaInicio" class="text-danger"></span>
            </div>

            <div>
                <div class="nombre">Duración</div>
                <div class="input-nombre">
                    <select asp-for="DuracionHoras">
                        <option value="1">1 Hora</option>
                        <option value="2">2 Horas</option>
                        <option value="3">3 Horas</option>
                        <option value="4">4 Horas</option>
                    </select>
                </div>
                <span asp-validation-for="DuracionHoras" class="text-danger"></span>
            </div>

            <!-- Botones centrados -->
            <div class="form-buttons">
                <div class="btn-submit-modal">
                    <div>Solicitar Reserva</div>
                    <input type="submit" />
                </div>
                <a asp-action="Index" class="btn-cancel-modal">Cancelar</a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
