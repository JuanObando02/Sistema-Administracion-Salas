@model IEnumerable<Services.Models.ReservaModels.ReservaIndexModel>
@{
    ViewData["Title"] = "Solicitudes Pendientes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1><i class="bi bi-inbox"></i> Solicitudes Pendientes</h1>

    @* Botón para ir al Historial Completo *@
    <a asp-action="Gestionar" class="btn btn-outline-secondary">
        <i class="bi bi-archive"></i> Ver Historial Completo / Editar
    </a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-success text-center">
        <i class="bi bi-check-circle-fill h3"></i>
        <p class="mb-0">¡Todo al día! No hay solicitudes pendientes de aprobación.</p>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Tipo</th>
                        <th>Solicitante</th> @* Sería ideal mostrar el nombre del usuario aquí *@
                        <th>Objeto</th>
                        <th>Horario</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @if (item.Tipo == Domain.Enums.TipoReserva.Sala)
                                {
                                    <span class="badge bg-primary">Sala</span>
                                }
                                else
                                {

                                    <span class="badge bg-info text-dark">Equipo</span>
                                }
                            </td>
                            <td>
                                @* Enlace que abre el modal y carga los datos *@
                                <a href="#"
                                   class="text-decoration-none fw-bold text-primary btn-detalle-usuario"
                                   data-nombre="@item.NombreSolicitante"
                                   data-email="@item.EmailSolicitante"
                                   data-documento="@item.DocumentoSolicitante"
                                   data-bs-toggle="modal"
                                   data-bs-target="#modalUsuario">

                                    <i class="bi bi-person-circle"></i> Ver Detalles
                                </a>
                            </td>
                            <td class="fw-bold">@item.ObjetoReservado</td>
                            <td>
                                <div>@item.FechaInicio.ToString("dd/MM/yyyy")</div>
                                <small class="text-muted">@item.FechaInicio.ToString("HH:mm") - @item.FechaFin.ToString("HH:mm")</small>
                            </td>
                            <td class="text-end">
                                <div class="d-flex gap-2 justify-content-end">
                                    @* APROBAR *@
                                    <form asp-action="Aprobar" asp-route-id="@item.Id" method="post">
                                        <button type="submit" class="btn btn-success btn-sm" title="Aprobar">
                                            <i class="bi bi-check-lg"></i> Aprobar
                                        </button>
                                        @* Truco: input hidden para redirigir de vuelta a Pendientes en vez de Gestionar *@
                                        <input type="hidden" name="returnUrl" value="Pendientes" />
                                    </form>

                                    @* RECHAZAR *@
                                    <form asp-action="Rechazar" asp-route-id="@item.Id" method="post" onsubmit="return confirm('¿Rechazar solicitud?');">
                                        <button type="submit" class="btn btn-danger btn-sm" title="Rechazar">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                        <input type="hidden" name="returnUrl" value="Pendientes" />
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
<div class="modal fade" id="modalUsuario" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="bi bi-person-vcard"></i> Información del Solicitante</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-4">
                    <i class="bi bi-person-circle display-1 text-secondary"></i>
                </div>

                <dl class="row">
                    <dt class="col-sm-4">Nombre:</dt>
                    <dd class="col-sm-8" id="modalNombre">Cargando...</dd>

                    <dt class="col-sm-4">Email:</dt>
                    <dd class="col-sm-8" id="modalEmail">Cargando...</dd>

                    <dt class="col-sm-4">Documento:</dt>
                    <dd class="col-sm-8" id="modalDocumento">Cargando...</dd>
                </dl>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $(document).ready(function () {
            // Cuando se hace clic en cualquier botón con la clase 'btn-detalle-usuario'
            $('.btn-detalle-usuario').click(function () {

                // 1. Obtener datos del botón clickeado (data-attributes)
                var nombre = $(this).data('nombre');
                var email = $(this).data('email');
                var documento = $(this).data('documento');

                // 2. Inyectar datos en el cuerpo del modal
                $('#modalNombre').text(nombre);
                $('#modalEmail').text(email);
                $('#modalDocumento').text(documento);
            });
        });
    </script>
}