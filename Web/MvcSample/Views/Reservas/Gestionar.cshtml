@model IEnumerable<Services.Models.ReservaModels.ReservaIndexModel>
@using Domain.Enums

@{
    ViewData["Title"] = "Gestión General de Reservas";
}

<h1>@ViewData["Title"]</h1>

<table class="table table-striped table-hover mt-4">
    <thead class="table-dark">
        <tr>
            <th>Tipo</th>
            <th>Objeto</th>
            <th>Desde</th>
            <th>Hasta</th>
            <th>Estado</th>
            @* Columna extra para el coordinador *@
            @* <th>Usuario</th> (Necesitarías agregar UsuarioNombre al modelo si quieres esto) *@
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Tipo</td>
                <td>@item.ObjetoReservado</td>
                <td>@item.FechaInicio.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@item.FechaFin.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    @if (item.Estado == EstadoReserva.Pendiente)
                    {
                        <span class="badge bg-warning text-dark">Pendiente</span>
                    }
                    else if (item.Estado == EstadoReserva.Aprobada)
                    {
                        <span class="badge bg-primary">Aprobada</span>
                    }
                    else if (item.Estado == EstadoReserva.Finalizada)
                    {
                        <span class="badge bg-secondary">Finalizada</span>
                    }
                    else if (item.Estado == EstadoReserva.EnUso)
                    {
                        <span class="badge bg-success">En Curso</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">@item.Estado</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
