@* IMPORTANTE: El modelo ahora es PaginatedList *@
@using Services.Models.Shared
@model PaginatedList<Services.Models.ReservaModels.ReservaIndexModel>
@using Domain.Enums

@{
    ViewData["Title"] = "Gestión General de Reservas";

    // Recuperar filtros para los enlaces de paginación
    var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
    var nextDisabled = !Model.HasNextPage ? "disabled" : "";
    var busqueda = ViewData["BusquedaActual"];
    var tipo = ViewData["TipoActual"];
    var fecha = ViewData["FechaActual"];
    var orden = ViewData["OrdenActual"] as string;
}

<h1>@ViewData["Title"]</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card mb-4 bg-light">
    <div class="card-body">
        <form asp-action="Gestionar" method="get" class="row g-3">

            @* 1. Buscador Texto *@
            <div class="col-md-3">
                <label class="form-label">Buscar</label>
                <input type="text" name="busqueda" class="form-control" placeholder="Sala N° o Serial..." value="@busqueda">
            </div>

            @* 2. Filtro Tipo *@
            <div class="col-md-2">
                <label class="form-label">Tipo</label>
                <select name="tipo" class="form-select" asp-items="Html.GetEnumSelectList<TipoReserva>()">
                    <option value="">-- Todos --</option>
                </select>
                @* Pequeño script inline para seleccionar el valor actual *@
                @if (tipo != null)
                {
                    <script>document.getElementsByName('tipo')[0].value = '@tipo';</script>
                }
            </div>

            @* 3. Filtro Fecha *@
            <div class="col-md-2">
                <label class="form-label">Fecha</label>
                <input type="date" name="fecha" class="form-control" value="@fecha">
            </div>

            @* 4. Ordenar Por *@
            <div class="col-md-3">
                <label class="form-label">Ordenar</label>
                <select name="ordenarPor" class="form-select">
                    <option value="fecha_desc">Fecha (Más recientes)</option>
                    <option value="fecha_asc">Fecha (Más antiguos)</option>
                    <option value="tipo_asc">Tipo (Equipo primero)</option>
                    <option value="tipo_desc">Tipo (Sala primero)</option>
                </select>
                @if (orden != null)
                {
                    <script>document.getElementsByName('ordenarPor')[0].value = '@orden';</script>
                }
            </div>

            @* 5. Botones *@
            <div class="col-md-2 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary w-100">Filtrar</button>
                <a asp-action="Gestionar" class="btn btn-outline-secondary" title="Limpiar"><i class="bi bi-x-lg"></i></a>
            </div>
        </form>
    </div>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Tipo</th>
            <th>Objeto</th>
            <th>Desde</th>
            <th>Hasta</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Tipo</td>
                <td>@item.ObjetoReservado</td>
                <td>@item.FechaInicio.ToString("dd/MM/yy HH:mm")</td>
                <td>@item.FechaFin.ToString("dd/MM/yy HH:mm")</td>
                <td>
                    @* (Tus badges de estado aquí...) *@
                    <span class="badge bg-secondary">@item.Estado</span>
                </td>
                <td>
                    @* --- REGLA 1: SI ESTÁ FINALIZADA O RECHAZADA, NO SE TOCA --- *@
                    @if (item.Estado == Domain.Enums.EstadoReserva.Finalizada || item.Estado == Domain.Enums.EstadoReserva.Rechazada)
                    {
                        <span class="text-muted fst-italic small">Archivada</span>
                    }
                    else
                    {
                        <div class="d-flex gap-2">

                            @* --- BOTONES DE APROBACIÓN (Solo si es Pendiente) --- *@
                            @if (item.Estado == Domain.Enums.EstadoReserva.Pendiente)
                            {
                                <form asp-action="Aprobar" asp-route-id="@item.Id" method="post">
                                    <button type="submit" class="btn btn-sm btn-success" title="Aprobar">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                </form>

                                <form asp-action="Rechazar" asp-route-id="@item.Id" method="post"
                                      onsubmit="return confirm('¿Rechazar solicitud?');">
                                    <button type="submit" class="btn btn-sm btn-danger" title="Rechazar">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </form>
                            }

                            @* --- BOTONES DE EDICIÓN/ELIMINACIÓN (Solo si NO está Finalizada/Rechazada) --- *@
                            @* Al estar dentro del 'else' principal, ya garantizamos que no es Finalizada *@

                            <a asp-action="EditarAdmin" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Modificar">
                                <i class="bi bi-pencil"></i>
                            </a>

                            <form asp-action="EliminarAdmin" asp-route-id="@item.Id" method="post"
                                  onsubmit="return confirm('¿Eliminar permanentemente? Esto liberará el recurso.');">
                                <button type="submit" class="btn btn-sm btn-dark" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>

                        </div>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<nav aria-label="Navegación de páginas">
    <ul class="pagination justify-content-center">
        <li class="page-item @prevDisabled">
            <a asp-action="Gestionar"
               asp-route-pagina="@(Model.PageIndex - 1)"
               asp-route-busqueda="@busqueda"
               asp-route-tipo="@tipo"
               asp-route-fecha="@fecha"
               asp-route-ordenarPor="@orden"
               class="page-link">Anterior</a>
        </li>

        <li class="page-item disabled"><span class="page-link">Página @Model.PageIndex de @Model.TotalPages</span></li>

        <li class="page-item @nextDisabled">
            <a asp-action="Gestionar"
               asp-route-pagina="@(Model.PageIndex + 1)"
               asp-route-busqueda="@busqueda"
               asp-route-tipo="@tipo"
               asp-route-fecha="@fecha"
               asp-route-ordenarPor="@orden"
               class="page-link">Siguiente</a>
        </li>
    </ul>
</nav>