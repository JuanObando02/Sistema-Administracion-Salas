@model IEnumerable<Services.Models.ReservaModels.ReservaIndexModel>
@using Domain.Enums

@{
    ViewData["Title"] = "Gestión General de Reservas";
}

<h1>@ViewData["Title"]</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-striped table-hover mt-4">
    <thead class="table-dark">
        <tr>
            <th>Tipo</th>
            <th>Objeto</th>
            <th>Desde</th>
            <th>Hasta</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Tipo</td>
                <td>@item.ObjetoReservado</td>
                <td>@item.FechaInicio.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@item.FechaFin.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    @* (Aquí van tus badges de estado) *@
                    <span class="badge bg-secondary">@item.Estado</span>
                </td>
                <td>
                    @* --- LÓGICA DE ACCIONES --- *@

                    @if (item.Estado == EstadoReserva.Finalizada || item.Estado == EstadoReserva.Rechazada)
                    {
                        <span class="text-muted fst-italic small">Archivada</span>
                    }
                    else
                    {
                        <div class="d-flex gap-2">

                            @* 1. BOTONES DE FLUJO (Solo Pendientes) *@
                            @if (item.Estado == EstadoReserva.Pendiente)
                            {
                                <form asp-action="Aprobar" asp-route-id="@item.Id" method="post">
                                    <button type="submit" class="btn btn-sm btn-success" title="Aprobar">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                </form>

                                <form asp-action="Rechazar" asp-route-id="@item.Id" method="post"
                                      onsubmit="return confirm('¿Rechazar solicitud?');">
                                    <button type="submit" class="btn btn-sm btn-danger" title="Rechazar">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </form>
                            }

                            @* 2. BOTONES ADMINISTRATIVOS (Siempre visibles si no está archivada) *@

                            <a asp-action="EditarAdmin" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Modificar">
                                <i class="bi bi-pencil"></i>
                            </a>

                            <form asp-action="EliminarAdmin" asp-route-id="@item.Id" method="post"
                                  onsubmit="return confirm('¿Eliminar permanentemente? Esto liberará el recurso.');">
                                <button type="submit" class="btn btn-sm btn-dark" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>

                        </div>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>