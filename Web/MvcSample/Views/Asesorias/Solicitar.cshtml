@model Services.Models.AsesoriaModels.RegistrarAsesoriaModel

@{
    ViewData["Title"] = "Solicitar Asesoría Técnica";
}

<link rel="stylesheet" href="~/css/equiposEdit.css" />

<div class="modal-wrapper">
    <div class="radix-ru">

        <!-- Título -->
        <div class="flex-flex-col-gap-2-text-center-sm-text-left">
            <div class="nuevo-usuario">@ViewData["Title"]</div>
            <div class="registra-un-nuevo-usuario-en-el-sistema">
                Use este módulo para reportar problemas y solicitar ayuda en sitio
            </div>
        </div>

        <!-- Formulario -->
        <form asp-action="Solicitar" method="post" class="form-space-y-4">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- UBICACIÓN (Sala) -->
            <div>
                <div class="nombre">Ubicación (Sala)</div>
                <div class="input-nombre">
                    <select asp-for="SalaId" asp-items="Model.SalasDisponibles">
                        <option value="">-- (Opcional) Estoy en un pasillo / cafetería --</option>
                    </select>
                </div>
                <div class="form-text">Seleccione la sala donde se encuentra para que el coordinador pueda ubicarlo rápidamente.</div>
                <span asp-validation-for="SalaId" class="text-danger"></span>
            </div>

            <!-- DESCRIPCIÓN DEL PROBLEMA -->
            <div>
                <div class="nombre">Descripción del Problema</div>
                <div class="input-nombre">
                    <textarea asp-for="Descripcion" rows="3" placeholder="Ej: No logro conectar mi portátil al proyector..."></textarea>
                </div>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <!-- Botones centrados -->
            <div class="form-buttons">
                <div class="btn-submit-modal">
                    <div class="registra-usuario">
                        <i class="bi bi-send"></i> Enviar Solicitud
                    </div>
                    <input type="submit" />
                </div>

                <a asp-action="Index" class="btn-cancel-modal">Cancelar</a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}


