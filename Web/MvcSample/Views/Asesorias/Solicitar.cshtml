@model Services.Models.AsesoriaModels.RegistrarAsesoriaModel

@{
    ViewData["Title"] = "Solicitar Asesoría Técnica";
}

<h2>@ViewData["Title"]</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Solicitar" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @* 1. UBICACIÓN (Sala) *@
            <div class="mb-3">
                <label asp-for="SalaId" class="form-label"></label>
                <select asp-for="SalaId" asp-items="Model.SalasDisponibles" class="form-control">
                    <option value="">-- (Opcional) Estoy en un pasillo / cafetería --</option>
                </select>
                <div class="form-text">Seleccione la sala donde se encuentra para que el coordinador pueda ubicarlo rápidamente.</div>
                <span asp-validation-for="SalaId" class="text-danger"></span>
            </div>

            @* 2. DESCRIPCIÓN DEL PROBLEMA *@
            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label"></label>
                <textarea asp-for="Descripcion" class="form-control" rows="4" placeholder="Ej: No logro conectar mi portátil al proyector..."></textarea>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-send"></i> Enviar Solicitud
                </button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}