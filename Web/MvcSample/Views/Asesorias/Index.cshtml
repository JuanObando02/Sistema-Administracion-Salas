@model IEnumerable<Services.Models.AsesoriaModels.AsesoriaIndexModel>
@using Domain.Enums

@{
    ViewData["Title"] = "Mis Solicitudes de Asesoría";
}

<link rel="stylesheet" href="~/css/tableSala.css" />

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-info">
    Use este módulo para solicitar ayuda técnica en sitio (ej. problemas de conexión, cables, proyector).
</div>

<p>
    <a asp-action="Solicitar" class="modern-btn btn-primary">
        <i class="bi bi-person-raised-hand"></i> Solicitar Ayuda
    </a>
</p>

<div class="table-wrapper">
    <table class="table-modern">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Ubicación</th>
                <th>Descripción</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        @if (item.Ubicacion != "Sin ubicación especificada")
                        {
                            <span class="fw-bold">@item.Ubicacion</span>
                        }
                        else
                        {
                            <span class="text-muted">Sin ubicación</span>
                        }
                    </td>
                    <td>@item.Descripcion</td>
                    <td>
                        @if (item.Estado == EstadoAsesoria.Pendiente)
                        {
                            <span class="badge-modern badge-warning">Pendiente</span>
                        }
                        else if (item.Estado == EstadoAsesoria.EnProceso)
                        {
                            <span class="badge-modern badge-info">En Camino</span>
                        }
                        else if (item.Estado == EstadoAsesoria.Cerrada)
                        {
                            <span class="badge-modern badge-success">Resuelta</span>
                        }
                        else
                        {
                            <span class="badge-modern badge-disabled">@item.Estado</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted mt-5">
        <p>No has realizado ninguna solicitud de asesoría reciente.</p>
    </div>
}
