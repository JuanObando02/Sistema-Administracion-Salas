@model Services.Models.UsuarioModels.EditarUsuarioRolesModel
@{
    ViewData["Title"] = "Eliminar Usuario";
}

<h2 class="text-danger">Eliminar Usuario</h2>
<h3>¿Está seguro de que desea eliminar a este usuario?</h3>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Email</dd>
    </dl>

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <form asp-action="EliminarConfirmado" method="post">
        <input type="hidden" asp-for="UsuarioId" />
        <input type="submit" value="Eliminar" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>