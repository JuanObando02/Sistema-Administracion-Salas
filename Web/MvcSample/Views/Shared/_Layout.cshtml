@using Microsoft.AspNetCore.Identity
<!DOCTYPE html>
<html lang="en">
@{
        var title = ViewData["Title"]?.ToString();
        var isLoginOrRegister = title == "Login" || title == "Register";
        var isBienvenido = title == "Bienvenido";
        var isAuthenticated = User.Identity.IsAuthenticated;

        // Mostrar sidebar solo si el usuario está autenticado y no es Login/Register/Bienvenido
        var showSidebar = isAuthenticated && !isLoginOrRegister && !isBienvenido;
        // Mostrar topbar solo si no hay sidebar (Bienvenido/Login/Register)
        var showTopbar = !showSidebar;
}

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema Gestor de Salas</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico?v=3" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MvcSample.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>

<body class="@(showSidebar ? "sidebar-active" : "")">

    @* ------------------ Topbar (Login/Register/Bienvenido) ------------------ *@
    @if (showTopbar)
    {
        <div class="d-flex justify-content-between align-items-center p-3 bg-light border-bottom">
            <a class="navbar-brand fw-bold fs-3 text-dark"
               asp-area="" asp-controller="Home" asp-action="Index">
                SalasSys
            </a>

            <div>
                @if (!isAuthenticated)
                {
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary me-2">Iniciar Sesión</a>
                    <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-secondary">Registrarse</a>
                }
            </div>
        </div>
    }

    @* ------------------ Sidebar (para usuarios autenticados) ------------------ *@
    @if (showSidebar)
    {
        <header>
            <nav class="navbar navbar-light bg-white border-end vh-100 position-fixed flex-column p-3">

                @* Logo al lado de SalasSys *@
                <div class="d-flex align-items-center mb-4">
                    <img src="~/img/Background.png" alt="Logo" style="width:40px; height:40px; margin-right:8px;" />
                    <a class="navbar-brand mb-0 text-dark fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                        SalasSys
                    </a>
                </div>

                <ul class="nav nav-pills flex-column mb-auto">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    </li>

                    @* --- BLOQUE ADMINISTRACIÓN --- *@
                    @if (User.IsInRole("Admin") || User.IsInRole("Coordinador"))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Salas" asp-action="Index">Gestión de Salas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Equipos" asp-action="Index">Gestión de Equipos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Reservas" asp-action="Gestionar">
                                <i class="bi bi-calendar-check"></i> Aprobar Reservas
                            </a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Usuarios" asp-action="Index">Gestión de Usuarios</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Roles" asp-action="Index">Gestión de Roles</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Reportes" asp-action="Registrar">
                                <i class="bi bi-exclamation-triangle"></i> Reportar Daño
                            </a>
                        </li>
                    }

                    @* --- ENLACES PARA TODOS LOS USUARIOS AUTENTICADOS --- *@
                    @if (!User.IsInRole("Admin") && !User.IsInRole("Coordinador"))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Reservas" asp-action="Index">Mis Reservas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Reportes" asp-action="MisReportes">Mis Reportes</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Asesorias" asp-action="Index">Asesorías</a>
                        </li>
                    }

                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                    </li>
                </ul>

                @* ------------------ Footer del sidebar (Hola + Cerrar Sesión) ------------------ *@
                <ul class="nav flex-column mt-auto">
                    <li class="nav-item">
                        <span class="nav-link text-dark">Hola, @User.Identity.Name!</span>
                    </li>
                    <li class="nav-item">
                        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout"
                              asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                            <button type="submit" class="btn btn-danger w-100">
                                <i class="bi bi-box-arrow-left me-1"></i> Cerrar Sesión
                            </button>
                        </form>
                    </li>
                </ul>
            </nav>
        </header>
    }

    @* ------------------ Contenido principal ------------------ *@
    <div class="flex-grow-1 p-3" style="@(showSidebar ? "margin-left:250px;" : "")">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @* ------------------ Scripts ------------------ *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>