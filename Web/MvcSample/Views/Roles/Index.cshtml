@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>
@{
    ViewData["Title"] = "Gestión de Roles";
}

<link rel="stylesheet" href="~/css/tableSala.css" />

<h1>Gestión de Roles</h1>

<p>
    <a asp-action="Crear" class="btn btn-primary">Crear Nuevo Rol</a>
</p>

<div class="table-wrapper">
    <table class="table-modern">
        <thead>
            <tr>
                <th>ID del Rol</th>
                <th>Nombre</th>
                <th>Opciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var rol in Model)
            {
                <tr>
                    <td>@rol.Id</td>
                    <td>@rol.Name</td>
                    <td>
                        <a asp-action="Editar"
                           asp-route-id="@rol.Id"
                           class="modern-btn btn-edit">
                            <i class="bi bi-pencil-square"></i>Editar
                        </a>

                        <a asp-action="Eliminar"
                           asp-route-id="@rol.Id"
                           class="modern-btn btn-delete">
                            <i class="bi bi-trash"></i>Eliminar
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>