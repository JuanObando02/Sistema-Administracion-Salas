@* Recibe una LISTA del modelo que creamos *@
@model IEnumerable<Services.Models.SalaModels.SalaIndexModel>
@using Domain.Enums

@{
    ViewData["Title"] = "Gestión de Salas";
}

<h1>@ViewData["Title"]</h1>

<div class="row mb-3 align-items-center">
    <div class="col-md-6">
        <a asp-action="Registrar" class="btn btn-primary">Registrar Nueva Sala</a>
    </div>
    @* --- FORMULARIO DE BÚSQUEDA --- *@
    <div class="col-md-6">
        <form asp-action="Index" method="get" class="d-flex gap-2 justify-content-end">
            <div class="input-group" style="max-width: 300px;">
                <span class="input-group-text" id="basic-addon1">N° Sala</span>

                @* El name="buscarNumero" debe coincidir con el parámetro del Controlador *@
                <input type="number" name="buscarNumero"
                       class="form-control"
                       placeholder="Ej. 101"
                       value="@ViewData["FiltroActual"]" />

                <button type="submit" class="btn btn-outline-secondary">Buscar</button>
            </div>

            @* Botón para limpiar el filtro (recarga la página sin parámetros) *@
            @if (ViewData["FiltroActual"] != null)
            {
                <a asp-action="Index" class="btn btn-link text-decoration-none">Ver Todas</a>
            }
        </form>
    </div>
</div>

<table class="table table-hover">
    <thead>
        <tr>
            <th>Nombre Sala</th>
            <th>Capacidad</th>
            <th>Tipo</th>
            <th>Estado</th>
            <th>Opciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>Sala @item.Numero</td>
                <td>@item.Capacidad</td>
                <td>
                    @if (item.Tipo == TipoSala.Individual)
                    {
                        <span class="badge bg-info text-dark">Individual</span>
                    }
                    else
                    {
                        <span class="badge bg-primary">Clase Completa</span>
                    }
                </td>
                <td>
                    @* Puedes darle color al estado también si quieres *@
                    @if (item.Estado == EstadoSala.Disponible)
                    {
                        <span class="badge bg-success">Disponible</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">@item.Estado</span>
                    }
                </td>
                <td>
                    <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a> |
                    <a asp-action="Eliminar" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a> |

                    <a asp-action="Index"
                       asp-controller="Equipos"
                       asp-route-salaId="@item.Id"
                       class="btn btn-sm btn-info">
                        Ver Equipos
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>