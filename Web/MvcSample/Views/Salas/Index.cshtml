@model IEnumerable<Services.Models.SalaModels.SalaIndexModel>
@using Domain.Enums

@{
    ViewData["Title"] = "Gestión de Salas";
}

<link rel="stylesheet" href="~/css/tableSala.css" />

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="row mb-4 align-items-center">
    <div class="col-md-6">
        <a asp-action="Registrar" class="btn btn-primary">Registrar Nueva Sala</a>
    </div>

    <div class="col-md-6 d-flex justify-content-end">

        <form asp-action="Index" method="get" class="search-wrapper">

            <div class="search-input">
                <input type="number"
                       name="buscarNumero"
                       value="@ViewData["FiltroActual"]"
                       placeholder="Buscar por número de sala..."
                       class="search-box" />
            </div>

            <button type="submit" class="search-btn">Buscar</button>

            @if (ViewData["FiltroActual"] != null)
            {
                <a asp-action="Index" class="search-clear">Ver Todas</a>
            }

        </form>

    </div>
</div>

<div class="table-wrapper">
    <table class="table-modern">
        <thead>
            <tr>
                <th>Nombre Sala</th>
                <th>Capacidad</th>
                <th>Tipo</th>
                <th>Estado</th>
                <th>Opciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>Sala @item.Numero</td>
                    <td>@item.Capacidad</td>

                    <td>
                        @if (item.Tipo == TipoSala.Individual)
                        {
                            <span class="badge-modern badge-info">Individual</span>
                        }
                        else
                        {
                            <span class="badge-modern badge-primary">Clase Completa</span>
                        }
                    </td>

                    <td>
                        @if (item.Estado == EstadoSala.Disponible)
                        {
                            <span class="badge-modern badge-success">Disponible</span>
                        }
                        else if (item.Estado == EstadoSala.Deshabilitada)
                        {
                            <span class="badge-modern badge-disabled">Deshabilitada</span>
                        }
                        else if (item.Estado == EstadoSala.EnMantenimiento)
                        {
                            <span class="badge-modern badge-maintenance">Mantenimiento</span>
                        }
                        else if (item.Estado == EstadoSala.Ocupada)
                        {
                            <span class="badge-modern badge-danger">Ocupada</span>
                        }
                    </td>


                    <td>
                        <a asp-action="Editar"
                           asp-route-id="@item.Id"
                           class="modern-btn btn-edit">
                            <i class="bi bi-pencil-square"></i>Editar
                        </a>

                        <a asp-action="Eliminar"
                           asp-route-id="@item.Id"
                           class="modern-btn btn-delete">
                            <i class="bi bi-trash"></i>Eliminar
                        </a>

                        <a asp-action="Index"
                           asp-controller="Equipos"
                           asp-route-salaId="@item.Id"
                           class="modern-btn btn-equipos">
                            <i class="bi bi-laptop"></i>Ver Equipos
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
