@* Recibe una LISTA del modelo que creamos *@
@model IEnumerable<Services.Models.SalaModels.SalaIndexModel>
@using Domain.Enums

@{
    ViewData["Title"] = "Gestión de Salas";
}

<h1>@ViewData["Title"]</h1>

<p>
    @* El botón "Registrar" en la parte superior *@
    <a asp-action="Registrar" class="btn btn-primary">Registrar Nueva Sala</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Nombre Sala</th>
            <th>Capacidad</th>
            <th>Tipo</th>
            <th>Estado</th>
            <th>Opciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>Sala @item.Numero</td>
                <td>@item.Capacidad</td>
                <td>
                    @if (item.Tipo == TipoSala.Individual)
                    {
                        <span class="badge bg-info text-dark">Individual</span>
                    }
                    else
                    {
                        <span class="badge bg-primary">Clase Completa</span>
                    }
                </td>
                <td>
                    @* Puedes darle color al estado también si quieres *@
                    @if (item.Estado == EstadoSala.Disponible)
                    {
                        <span class="badge bg-success">Disponible</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">@item.Estado</span>
                    }
                </td>
                <td>
                    <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a> |
                    <a asp-action="Eliminar" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a> |

                    <a asp-action="Index"
                       asp-controller="Equipos"
                       asp-route-salaId="@item.Id"
                       class="btn btn-sm btn-info">
                        Ver Equipos
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>