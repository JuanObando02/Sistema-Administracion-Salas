@* Usamos el EditarSalaModel solo para mostrar los datos *@
@model Services.Models.SalaModels.EditarSalaModel

@{
    ViewData["Title"] = "Eliminar Sala";
}

<h2>@ViewData["Title"]</h2>
<h3 class="text-danger">¿Está seguro de que desea eliminar esta sala?</h3>

<div>
    <h4>Sala N° @Model.Numero</h4>
    <hr />

    @* Muestra el error de "Sala con equipos" aquí *@
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <dl class="row">
        <dt class="col-sm-2">Número</dt>
        <dd class="col-sm-10">@Model.Numero</dd>

        <dt class="col-sm-2">Capacidad</dt>
        <dd class="col-sm-10">@Model.Capacidad</dd>

        <dt class="col-sm-2">Estado</dt>
        <dd class="col-sm-10">@Model.Estado</dd>
    </dl>

    @* Este formulario envía al POST "EliminarConfirmado" *@
    <form asp-action="EliminarConfirmado" method="post">
        @* Pasamos el ID para que la acción POST sepa qué borrar *@
        <input type="hidden" asp-for="Id" />

        <input type="submit" value="Eliminar" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>