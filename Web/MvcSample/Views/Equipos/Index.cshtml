@model IEnumerable<Services.Models.EquipoModels.EquipoIndexModel>

@{
    ViewData["Title"] = "Gestión de Equipos";
    // Recupera el SalaId que el Controlador envió
    Guid? salaId = ViewBag.SalaId;
}

<h1>@ViewData["Title"]</h1>

<p>
    @* Si venimos de una sala, el botón "Registrar" pasará ese ID *@
    @if (salaId.HasValue)
    {
        <a asp-action="Registrar" asp-route-salaId="@salaId.Value" class="btn btn-primary">Registrar Nuevo Equipo (en esta Sala)</a>
        <a asp-action="Index" asp-controller="Salas" class="btn btn-secondary">Volver al Listado de Salas</a>
    }
    else
    {
        <a asp-action="Registrar" class="btn btn-primary">Registrar Nuevo Equipo (General)</a>
    }
</p>
<table class="table">
    <thead>
        <tr>
            <th>Serial</th>
            <th>Estado</th>
            <th>Sala</th>
            <th>Opciones</th>
        </tr>
    </thead>
    <tbody>
        @* Itera sobre la lista de equipos que el controlador envió *@
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.Serial
                </td>
                <td>
                    @item.Estado
                </td>
                <td>
                    @item.SalaNombre
                </td>
                <td>
                    <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a> |
                    <a asp-action="Eliminar" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>