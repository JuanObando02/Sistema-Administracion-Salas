@model IEnumerable<Services.Models.EquipoModels.EquipoIndexModel>

@{
    ViewData["Title"] = "Gestión de Equipos";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Registrar" class="btn btn-primary">Registrar Nuevo Equipo</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Serial</th>
            <th>Estado</th>
            <th>Sala</th>
            <th>Opciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Serial</td>
                <td>@item.Estado</td>
                <td>@item.SalaNombre</td>
                <td>
                    <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a> |
                    <a asp-action="Eliminar" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>