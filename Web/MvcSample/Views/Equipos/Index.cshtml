@model IEnumerable<Services.Models.EquipoModels.EquipoIndexModel>

@{
    ViewData["Title"] = "Gestión de Equipos";
    Guid? salaId = ViewBag.SalaId;
}

<link rel="stylesheet" href="~/css/tableSala.css" />

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="row mb-4 align-items-center">

    <div class="col-md-6">

        @if (salaId.HasValue)
        {
            <a asp-action="Registrar"
               asp-route-salaId="@salaId.Value"
               class="btn btn-primary">
                Registrar Nuevo Equipo (en esta Sala)
            </a>

            <a asp-action="Index"
               asp-controller="Salas"
               class="btn btn-secondary">
                Volver al Listado de Salas
            </a>
        }
        else
        {
            <a asp-action="Registrar"
               class="btn btn-primary">
                Registrar Nuevo Equipo (General)
            </a>
        }
    </div>

    <div class="col-md-6 d-flex justify-content-end">

        <form asp-action="Index" method="get" class="search-wrapper">

            @if (salaId.HasValue)
            {
                <input type="hidden" name="salaId" value="@salaId.Value" />
            }

            <div class="search-input">
                <input type="text"
                       name="buscarSerial"
                       value="@ViewData["FiltroSerial"]"
                       placeholder="Buscar por serial..."
                       class="search-box" />
            </div>

            <button type="submit" class="search-btn">Buscar</button>

            @if (ViewData["FiltroSerial"] != null)
            {
                @if (salaId.HasValue)
                {
                    <a asp-action="Index"
                       asp-route-salaId="@salaId.Value"
                       class="search-clear">
                        Ver Todos
                    </a>
                }
                else
                {
                    <a asp-action="Index"
                       class="search-clear">
                        Ver Todos
                    </a>
                }
            }

        </form>

    </div>

</div>


<div class="table-wrapper">
    <table class="table-modern">
        <thead>
            <tr>
                <th>Serial</th>
                <th>Estado</th>
                <th>Sala</th>
                <th>Opciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.Serial</td>

                    <td>
                        <span class="badge-modern badge-info">@item.Estado</span>
                    </td>

                    <td>@item.SalaNombre</td>

                    <td>
                        <a asp-action="Editar"
                           asp-route-id="@item.Id"
                           class="modern-btn btn-edit">
                            <i class="bi bi-pencil-square"></i>Editar
                        </a>

                        <a asp-action="Eliminar"
                           asp-route-id="@item.Id"
                           class="modern-btn btn-delete">
                            <i class="bi bi-trash"></i>Eliminar
                        </a>
                    </td>

                </tr>
            }
        </tbody>

    </table>
</div>