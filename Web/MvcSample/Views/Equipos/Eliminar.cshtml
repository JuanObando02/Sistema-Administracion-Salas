@model Services.Models.EquipoModels.EditarEquipoModel

@{
    ViewData["Title"] = "Eliminar Equipo";
}

<h2>@ViewData["Title"]</h2>
<h3 class="text-danger">¿Está seguro de que desea eliminar este equipo?</h3>

<div>
    <h4>Equipo: @Model.Serial</h4>
    <hr />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <dl class="row">
        <dt class="col-sm-2">Serial</dt>
        <dd class="col-sm-10">@Model.Serial</dd>

        <dt class="col-sm-2">Estado</dt>
        <dd class="col-sm-10">@Model.Estado</dd>
    </dl>

    <form asp-action="EliminarConfirmado" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Eliminar" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>